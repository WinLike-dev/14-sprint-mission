@startuml
!pragma layout smetana

title Discodeit 클래스 다이어그램
left to right direction

hide empty members

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 6
skinparam nodesep 35
skinparam ranksep 45
skinparam ArrowColor #52606D
skinparam ArrowFontColor #334E68
skinparam ArrowFontSize 10
skinparam ClassBorderColor #52606D
skinparam ClassBackgroundColor #FFF8E7
skinparam ClassFontColor #1F2933
skinparam ClassFontSize 12
skinparam ClassStereotypeFontColor #52606D
skinparam ClassStereotypeFontSize 10
skinparam PackageBorderColor #9AA5B1
skinparam PackageBackgroundColor #F8FAFC

package "application" {
    class JavaApplication
}

package "factory" {
    class ServiceFactory
    class LazyHolder <<private static>>
}

package "service" {
    interface UserService
    interface ChannelService
    interface MessageService
}

package "service.basic" {
    class BasicUserService
    class BasicChannelService
    class BasicMessageService
}

package "repository" {
    interface CrudRepository<T>
}

package "repository.jcf" {
    class JCFObjectStore<T> <<final>>
    class JCFMessageRepository
    class JCFChannelRepository
    class JCFUserRepository
}

package "repository.file" {
    class FileObjectStore<T> <<final>>
    class FileMessageRepository
    class FileChannelRepository
    class FileUserRepository
}

package "entity" {
    class Message
    class Channel
    class User
    enum ChannelType
    interface Serializable <<JDK>>
    interface Identifiable
}

JavaApplication ..> UserService
JavaApplication ..> ChannelService
JavaApplication ..> MessageService

ServiceFactory --> UserService
ServiceFactory --> ChannelService
ServiceFactory --> MessageService

UserService <|.. BasicUserService
ChannelService <|.. BasicChannelService
MessageService <|.. BasicMessageService

BasicUserService --> CrudRepository : User
BasicChannelService --> CrudRepository : Channel
BasicMessageService --> CrudRepository : Message / User / Channel

CrudRepository <|.. JCFUserRepository : User
CrudRepository <|.. JCFChannelRepository : Channel
CrudRepository <|.. JCFMessageRepository : Message
CrudRepository <|.. FileUserRepository : User
CrudRepository <|.. FileChannelRepository : Channel
CrudRepository <|.. FileMessageRepository : Message

JCFObjectStore ..> Identifiable : T extends
FileObjectStore ..> Identifiable : T extends
FileObjectStore ..> Serializable : T extends

Identifiable <|.. User
Identifiable <|.. Channel
Identifiable <|.. Message
Serializable <|.. User
Serializable <|.. Channel
Serializable <|.. Message

' 범위: 프로덕션 최상위 타입 22개 + 내부 LazyHolder + 외부 Serializable.
' 관계선: 실제 인터페이스 호출, 주입, 구현, 제네릭 계약만 표시한다.

@enduml
